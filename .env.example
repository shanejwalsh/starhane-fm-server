# Copy to .env for local development. The makefile loads .env automatically;
# production reads real environment variables, so there is no dotenv library
# in the Go code.

# --- required ---------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/starhane_fm?sslmode=disable

# Integration tests are skipped unless this is set. Never point it at a
# database you care about: each run drops and recreates the schema.
TEST_DATABASE_URL=postgres://localhost:5432/starhane_fm_test?sslmode=disable

# --- api --------------------------------------------------------------------
PORT=8000

# --- logging ----------------------------------------------------------------
# LOG_LEVEL: debug | info | warn | error        (default info)
# LOG_FORMAT: pretty | json | text
#   Unset means pretty on a terminal and json otherwise, so local runs are
#   readable and production stays parseable without configuring either.
#   Colour follows NO_COLOR / FORCE_COLOR.
LOG_LEVEL=debug
LOG_FORMAT=pretty

# --- connection pool --------------------------------------------------------
# Set explicitly: the API and crawler share one database's connection limit.
DB_MAX_CONNS=10
DB_MIN_CONNS=1

# --- crawler ----------------------------------------------------------------
# CRAWLER_WORKERS=8
# CRAWLER_BATCH_SIZE=20
# CRAWLER_POLL_INTERVAL=30s
# CRAWLER_HTTP_TIMEOUT=30s
# CRAWLER_MAX_BODY_BYTES=20971520
# CRAWLER_HOST_RPS=1
# CRAWLER_HOST_BURST=2
# CRAWLER_USER_AGENT=starhane-fm/1.0 (+https://github.com/shanejwalsh/starhane-fm-server)
# CRAWLER_MIN_INTERVAL=1h
# CRAWLER_MAX_INTERVAL=24h
# CRAWLER_MAX_FAILURES=10
# CRAWLER_DEAD_RECHECK=720h
# CRAWLER_LEASE_DURATION=15m
# CRAWLER_SYNC_BUDGET=20s
# CRAWLER_EPISODE_GRACE_CRAWLS=5

# --- catalogue --------------------------------------------------------------
# FEED_REQUEST_THROTTLE=1h

# --- itunes -----------------------------------------------------------------
# ITUNES_TIMEOUT=10s
# ITUNES_SEARCH_LIMIT=50
# ITUNES_COUNTRY=GB
